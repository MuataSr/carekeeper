[Unit]
Description=Rig Keeper care agent (on-device caretaker)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=papichulo
WorkingDirectory=/home/papichulo/rig-keeper
ExecStart=/usr/bin/python3 /home/papichulo/rig-keeper/care_agent.py --check
# Phase 1: replace with a timer (daily check + weekly report)

[Install]
WantedBy=multi-user.target
