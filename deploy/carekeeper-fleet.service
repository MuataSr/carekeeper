[Unit]
Description=CareKeeper fleet check (hub)
After=carekeeper-brain.service
Wants=carekeeper-brain.service

[Service]
Type=oneshot
WorkingDirectory=%h/rig-keeper
ExecStart=/usr/bin/python3 %h/rig-keeper/fleet_check.py --once
StandardOutput=journal
StandardError=journal
SyslogIdentifier=carekeeper-fleet
